rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 각자 자기 출석부(users/<내 계정>/...)만 읽고 쓸 수 있어요.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 학부모 알림 링크: 링크 코드를 아는 사람만 열 수 있고, 만든 선생님만 고치거나 지울 수 있어요.
    match /links/{code} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if (request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["joined"]) && request.resource.data.joined is int);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      // 부모님 휴대폰의 알림 주소: 부모님은 등록만, 선생님은 확인·삭제만 할 수 있어요.
      match /devices/{id} {
        allow create, update: if exists(/databases/$(database)/documents/links/$(code))
          && request.resource.data.keys().hasOnly(["token", "ua", "at"])
          && request.resource.data.token is string && request.resource.data.token.size() < 1000;
        allow read, delete: if request.auth != null && get(/databases/$(database)/documents/links/$(code)).data.uid == request.auth.uid;
      }
    }
  }
}
